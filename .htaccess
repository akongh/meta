#доступ
AuthName "Мета"
AuthType Basic
#AuthUserFile /home/webart/www/meta_access/.htpasswd
AuthUserFile E:/www/meta/meta_access/.htpasswd
require valid-user

#запрет выдачи листинга пустого каталога 
Options -Indexes

#назначаем главный файл сайта
DirectoryIndex index.php

#404
ErrorDocument 404 /php/404.php

#503
ErrorDocument 503 /php/503.php

#обслуживание
#RewriteEngine On
#RewriteCond %{REMOTE_ADDR} !^127.0.0.1
#RewriteCond %{REMOTE_ADDR} !^178.121.159.110
#RewriteCond %{REMOTE_ADDR} !^178.121.159.110
#RewriteCond %{SCRIPT_FILENAME} !/php/503.php
#RewriteRule ^.*$ /php/503.php [R=503,L]